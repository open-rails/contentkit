{
  "name": "@openrails/contentkit-ui",
  "version": "0.0.0",
  "description": "ContentKit in the browser: client, React hooks and styled components for media, uploads and content URLs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-rails/contentkit.git",
    "directory": "sdk/ui"
  },
  "homepage": "https://github.com/open-rails/contentkit/tree/master/sdk/ui#readme",
  "bugs": {
    "url": "https://github.com/open-rails/contentkit/issues"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./urls": {
      "types": "./dist/urls/index.d.ts",
      "import": "./dist/urls.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "contract": "cd ../.. && GOWORK=off go generate ./internal/contract",
    "contract:check": "pnpm contract && git diff --exit-code -- src/client/generated ../../api ../../docs/api && test -z \"$(git status --porcelain -- src/client/generated ../../api ../../docs/api)\"",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration && vitest run --project integration-dom",
    "demo": "node e2e/support/up.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:browser": "playwright test",
    "test:e2e": "node e2e/support/run.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@noble/hashes": "^2.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "hls.js": "1.7.3",
    "react-easy-crop": "6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openrails/auth-ui": "1.15.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.1",
    "vitest": "^4.1.11"
  }
}
