{
  "name": "@openrails/contentkit-urls",
  "version": "0.0.0",
  "description": "ContentKit content URLs in the browser: parse and normalize codes, build canonical /{route}/{CODE}/{slug} paths, decide client-side canonical replacements.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-rails/contentkit.git",
    "directory": "sdk/urls"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm build && pnpm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
